# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build output ───────────────────────────────────────────────────
/.next/
/out/
/build
/dist
next-env.d.ts

# ── Testing / coverage ───────────────────────────────────────────────────────
/coverage
*.lcov

# ── Env files (keep .env.example tracked) ────────────────────────────────────
.env*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript / tool caches ─────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.turbo
.cache

# ── Deploy ───────────────────────────────────────────────────────────────────
.vercel
.netlify

# ── Supabase (local CLI state; keep migrations / config.toml / seed / tests) ─
supabase/.branches
supabase/.temp
supabase/.env

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.suo
*.swp
*.swo
*~

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Secrets / keys ───────────────────────────────────────────────────────────
*.pem

# ── Claude Code local settings (personal, not shared) ────────────────────────
.claude/settings.local.json

# ── Personal / internal notes (kept on disk, excluded from the submission) ────
docs/WALKTHROUGH-TR.md
docs/HANDOFF.md
docs/memory/
