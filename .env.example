# ── Supabase ─────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in from your Supabase project
# (Dashboard → Project Settings → API).

# Public client config (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only secret — NEVER prefix with NEXT_PUBLIC_.
# Used by migrations / pgTAP / admin maintenance, not by the app at runtime.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
