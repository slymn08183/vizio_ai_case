# Hoist ESLint plugins to the top-level node_modules so eslint-config-next's
# legacy plugin references (react-hooks, @next/next, react, import, ...) resolve
# under pnpm's strict layout. Without this, `next lint` / `next build`'s lint
# step fails with "Failed to load plugin 'react-hooks'".
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@typescript-eslint/*
